#!/bin/bash
# sigmaos-doctor — SigmaOS diagnostics
# Checks boot/session, display, network, audio, disk, and update health.
# Prints plain-language results and suggests safe next steps.
# Exit code: 0 = all checks passed, 1 = one or more warnings, 2 = failures.

set -u
FAIL=0
WARN=0

ok()   { printf '  \033[32m[OK]\033[0m   %s\n' "$1"; }
bad()  { printf '  \033[31m[FAIL]\033[0m %s\n' "$1"; FAIL=1; }
warn() { printf '  \033[33m[WARN]\033[0m %s\n' "$1"; WARN=1; }
info() { printf '        %s\n' "$1"; }

section() { printf '\n== %s ==\n' "$1"; }

section "Identity"
if [ -r /etc/os-release ]; then
  . /etc/os-release
  info "Distro: ${PRETTY_NAME:-unknown}"
else
  warn "/etc/os-release missing"
fi
if [ -b /dev/sr0 ] || findmnt -rn -o SOURCE /run/archiso 2>/dev/null | grep -q .; then
  info "Running from live ISO media"
fi

section "Boot / Session"
if [ "$(id -u)" = "0" ]; then
  info "Running as root"
elif [ -n "${SUDO_USER:-}" ]; then
  info "Running as $USER via sudo"
fi
if [ -d /run/systemd/system ]; then
  ok "systemd is PID 1"
else
  bad "systemd is not running as init"
fi
systemctl is-system-running 2>/dev/null | grep -qE '^(running|degraded)$' \
  && ok "system state: $(systemctl is-system-running 2>/dev/null)" \
  || warn "system state: $(systemctl is-system-running 2>/dev/null) (degraded units may need attention)"

section "Display / Desktop"
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  ok "Wayland session active ($WAYLAND_DISPLAY)"
else
  warn "No Wayland session — are you in a graphical session?"
fi
if pgrep -x Hyprland >/dev/null 2>&1; then
  ok "Hyprland compositor running"
else
  warn "Hyprland not detected (fine on TTY; needed for desktop)"
fi
for app in waybar foot rofi; do
  if pgrep -x "$app" >/dev/null 2>&1; then ok "$app running"; else warn "$app not running"; fi
done

section "Network"
if systemctl is-active --quiet NetworkManager 2>/dev/null; then
  ok "NetworkManager active"
  ip -br addr show 2>/dev/null | awk 'NR>1 && $2!="DOWN" {print "      " $1" "$3}' | head -5
  if ping -c1 -W3 archlinux.org >/dev/null 2>&1; then
    ok "Internet connectivity"
  else
    warn "No internet connectivity — check Wi-Fi/Ethernet"
  fi
else
  bad "NetworkManager is not active"
  info "Try: sudo systemctl start NetworkManager"
fi

section "Audio"
if command -v wpctl >/dev/null 2>&1; then
  sinks=$(wpctl status 2>/dev/null | grep -c "Audio/Sink" || true)
  if [ "$sinks" -gt 0 ]; then ok "PipeWire/WirePlumber: $sinks sink(s)"; else warn "No audio sinks found"; fi
elif command -v pactl >/dev/null 2>&1; then
  pactl info >/dev/null 2>&1 && ok "PulseAudio/PipeWire running" || warn "No audio server detected"
else
  warn "No audio control tool found"
fi

section "Storage"
df -h / /tmp 2>/dev/null | awk 'NR>1 {printf "      %-8s %s used / %s total (%s)\n", $6, $3, $2, $5}'
avail_kb=$(df -Pk / | awk 'NR==2 {print $4}')
if [ "${avail_kb:-0}" -lt 524288 ]; then
  warn "Less than 512 MiB free on / — consider cleanup"
elif [ "${avail_kb:-0}" -lt 2097152 ]; then
  info "Under 2 GiB free on / — monitor disk usage"
else
  ok "Sufficient free space on /"
fi

section "Updates / Packages"
if command -v pacman >/dev/null 2>&1; then
  ok "pacman available ($(pacman --version 2>/dev/null | head -1 | awk '{print $2}'))"
  pending=$(checkupdates 2>/dev/null | wc -l || pacman -Qu 2>/dev/null | wc -l)
  if [ "${pending:-0}" -gt 0 ]; then
    info "$pending package update(s) pending — run: sudo sigmaos-update full"
  else
    ok "No pending package updates"
  fi
else
  bad "pacman not found — not an Arch-based system?"
fi

section "Security"
if [ -f /etc/shadow ] && [ "$(stat -c %a /etc/shadow)" = "640" -o "$(stat -c %a /etc/shadow)" = "600" ]; then
  ok "/etc/shadow permissions correct"
else
  warn "/etc/shadow permissions look wrong: $(stat -c %a /etc/shadow 2>/dev/null)"
fi
if command -v fail2ban-client >/dev/null 2>&1; then info "fail2ban installed"; fi

printf '\n== Summary ==\n'
if [ "$FAIL" -eq 0 ] && [ "$WARN" -eq 0 ]; then
  printf '  \033[32mAll checks passed.\033[0m\n'
elif [ "$FAIL" -eq 0 ]; then
  printf '  \033[33mPassed with warnings — review [WARN] items above.\033[0m\n'
else
  printf '  \033[31mFailures found — review [FAIL] items above.\033[0m\n'
  printf '  Logs: journalctl -b -p err\n'
fi
printf '  Docs: https://aaryansinghchauhan09.github.io/Sigma/download.html\n\n'
[ "$FAIL" -eq 1 ] && exit 2
[ "$WARN" -eq 1 ] && exit 1
exit 0
